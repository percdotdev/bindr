{
  "extends": "@workspace/ts-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@workspace/db/*": ["./src/*"]
    },
    "strictNullChecks": true,
    "types": ["node"]
  },
  "include": ["src", "drizzle.config.ts"],
  "exclude": ["node_modules", "migrations"]
}
