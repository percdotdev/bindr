{
  "extends": "@workspace/ts-config/base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "paths": {
      "@workspace/auth/*": ["./src/*"],
      "@workspace/db/*": ["../db/src/*"]
    },
    "strictNullChecks": true,
    "types": ["bun"]
  },
  "include": ["src", "auth.config.ts"],
  "exclude": ["node_modules"]
}
