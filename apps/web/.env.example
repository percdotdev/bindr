# Copy to .env.local and fill in. Never commit real values.

# Neon Postgres (Vercel Marketplace). Pooled connection string.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/neondb?sslmode=require

# 32+ random bytes, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Public origin of this deployment; also the Steam OpenID realm.
BETTER_AUTH_URL=http://localhost:3000

# Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=
