{
  "name": "bindr",
  "version": "0.4.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "auth:generate": "turbo auth:generate",
    "build": "turbo build",
    "check": "ultracite check",
    "db:generate": "turbo db:generate",
    "db:migrate": "turbo db:migrate",
    "dependencies:update": "pnpm dlx taze -r -w -f",
    "dev": "turbo dev",
    "fix": "ultracite fix",
    "prepare": "husky",
    "release": "pnpm dlx bumpp -r",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@workspace/biome-config": "workspace:*",
    "@workspace/ts-config": "workspace:*",
    "bumpp": "^12.3.0",
    "husky": "^9.1.7",
    "turbo": "^2.11.10",
    "typescript": "^7",
    "ultracite": "8.1.0"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.22.2"
  }
}
